AIOTV_PUBLIC_URL=https://aiocontrol.peden88.stream
AIOTV_ADMIN_PASSWORD=replace-with-your-password
AIOTV_SESSION_SECRET=replace-with-at-least-32-random-characters
AIOTV_DATABASE_PATH=/app/data/aiotv-control.sqlite
AIOTV_HOST=0.0.0.0
AIOTV_PORT=3000
AIOTV_COOKIE_SECURE=true
AIOTV_ALLOW_HTTP_ADDONS=false
AIOTV_PAIRING_TTL_SECONDS=900
AIOTV_PAIRING_POLL_SECONDS=3
AIOTV_ADMIN_SESSION_SECONDS=43200
