AIOTV_PUBLIC_URL=https://aiotv-control.example.com
AIOTV_ADMIN_PASSWORD_HASH=scrypt.replace-with-output-from-npm-run-hash-password
AIOTV_SESSION_SECRET=replace-with-at-least-32-random-characters
AIOTV_DATABASE_PATH=/app/data/aiotv-control.sqlite
AIOTV_PORT=3000
AIOTV_COOKIE_SECURE=true
AIOTV_ALLOW_HTTP_ADDONS=false
